:root{--navy:#102C44;--orange:#ED651B;--orange-d:#d4540f;--muted:#61717D;--pale:#F5F7F8;--line:#E5E9EB;--o300:#FDBA74;--r:14px;--sh:0 8px 24px rgba(16,44,68,.10)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',system-ui,-apple-system,Segoe UI,Arial,sans-serif;color:var(--navy);background:#fff;line-height:1.55;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
.wrap{width:min(1192px,100% - 40px);margin-inline:auto}
h1,h2,h3{letter-spacing:-.02em;line-height:1.15;font-weight:800}
h2{font-size:clamp(28px,4vw,40px)}
.muted{color:var(--muted)}
.eyebrow{display:block;font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--orange);margin-bottom:10px}
.section{padding:80px 0}
.section.pale{background:var(--pale)}
.section.navy{background:var(--navy);color:#fff}
.section.navy .muted{color:#e2e8f0}
.section-head{margin-bottom:36px}
.section-head p{margin-top:10px;color:var(--muted)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;cursor:pointer;font:700 15px 'DM Sans',sans-serif;padding:13px 22px;border-radius:9px;transition:.15s}
.btn-o{background:var(--orange);color:#fff}.btn-o:hover{background:var(--orange-d)}
.btn-l{background:#fff;color:var(--navy);border:1px solid #CBD4D9}.btn-l:hover{border-color:var(--navy)}
.btn-block{width:100%}
.center{text-align:center;margin-top:36px}

/* header */
.hd{position:sticky;top:0;z-index:50;background:#fff;box-shadow:0 2px 14px rgba(16,44,68,.08)}
.hd-in{display:flex;align-items:center;gap:28px;height:78px}
.logo img{height:44px;width:auto}
.menu{display:flex;align-items:center;flex:1;gap:28px}
.nav{display:flex;gap:26px;flex:1}
.nav a,.hd-r a:not(.btn){font-weight:500;font-size:15px;padding:6px 0;border-bottom:2px solid transparent}
.nav a:hover,.nav a.on{color:var(--orange);border-color:var(--orange)}
.hd-r{display:flex;align-items:center;gap:22px}
#favcount{background:var(--orange);color:#fff;border-radius:20px;font-size:11px;padding:1px 7px;margin-left:2px}
.burger{display:none;margin-left:auto;background:none;border:0;font-size:28px;cursor:pointer;color:var(--navy)}

/* hero */
.hero{position:relative;color:#fff;background:linear-gradient(rgba(16,44,68,.72),rgba(16,44,68,.72)),url('https://images.pexels.com/photos/1571460/pexels-photo-1571460.jpeg?auto=compress&cs=tinysrgb&w=1920') center/cover,var(--navy);padding:140px 0 110px}
.hero .eyebrow{color:var(--o300)}
.hero h1{font-size:clamp(36px,6vw,64px);max-width:780px;margin-bottom:20px}
.hero p.lead{font-size:18px;max-width:640px;margin-bottom:36px}
.searchbar{background:#fff;border-radius:16px;box-shadow:var(--sh);display:grid;grid-template-columns:1.4fr 1fr 1fr auto;gap:0;align-items:stretch;padding:12px;max-width:1060px;color:var(--navy)}
.sfield{display:flex;flex-direction:column;gap:2px;padding:6px 18px;border-right:1px solid var(--line);min-width:0}
.sfield:nth-child(3){border-right:0}
.sfield label{font-size:12px;font-weight:800}
.sfield input,.sfield select{border:0;outline:0;background:transparent;font:500 15px 'DM Sans',sans-serif;color:#314657;padding:4px 0;width:100%;cursor:pointer}
.sfield input{cursor:text}
.searchbar .btn{padding:0 34px;font-size:16px}
.quick{margin-top:24px;font-weight:700}

/* cartes */
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.card{position:relative;background:#fff;border-radius:var(--r);box-shadow:var(--sh);overflow:hidden;display:flex;flex-direction:column;transition:.2s}
.card:hover{transform:translateY(-4px)}
.card-img{position:relative;display:block;height:225px;background:#DDE4E8}
.card-img img{width:100%;height:100%;object-fit:cover}
.badge{position:absolute;left:15px;top:15px;background:#fff;font-size:12px;font-weight:800;padding:5px 11px;border-radius:6px}
.heart{position:absolute;right:15px;top:14px;width:39px;height:39px;border-radius:50%;border:0;background:#fff;cursor:pointer;font-size:19px;color:#9AA9B3;display:grid;place-items:center;box-shadow:0 2px 8px rgba(0,0,0,.15)}
.heart.on{color:var(--orange)}
.card-b{padding:18px 20px 20px;display:flex;flex-direction:column;gap:4px;flex:1}
.card-b .eyebrow{font-size:12px;margin:0}
.card-b h3{font-size:18px;line-height:1.3}
.card-b p{font-size:14px;color:var(--muted)}
.card-f{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:auto;padding-top:14px;border-top:1px solid #F1F5F9}
.card-f b{font-size:16px;font-weight:800}
.card-f a{font-size:14px;font-weight:700;color:var(--orange)}
.demo-note{font-size:12px;color:var(--muted)}

/* tuiles */
.tiles{display:grid;gap:16px}
.tiles.t4{grid-template-columns:repeat(4,1fr)}
.tile{position:relative;border-radius:12px;overflow:hidden;color:#fff;background:#B7C4CC;display:block}
.tile img{width:100%;height:100%;object-fit:cover;transition:.3s}
.tile:hover img{transform:scale(1.05)}
.tile::after{content:'';position:absolute;inset:0;background:rgba(16,44,68,.32)}
.tile span{position:absolute;left:18px;bottom:16px;z-index:2;font-weight:800;font-size:20px}
.tile.big{height:256px}.tile.sm{height:176px}

/* étapes / avantages */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
.step-n{width:48px;height:48px;border-radius:50%;background:rgba(237,101,27,.12);color:var(--orange);font-weight:800;display:grid;place-items:center;margin-bottom:16px}
.step h3{font-size:19px;margin-bottom:8px}.step p{color:var(--muted);font-size:15px}
.split{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.split img{border-radius:12px;width:100%;height:430px;object-fit:cover;background:#CBD4DA}
.split p{color:var(--muted);margin:16px 0 26px;font-size:16px}
.perks{display:grid;grid-template-columns:1fr 1fr;gap:30px}
.perk i{display:block;width:36px;height:36px;border-radius:50%;background:rgba(253,186,116,.25);position:relative;margin-bottom:14px}
.perk i::after{content:'';position:absolute;inset:11px;border-radius:50%;background:var(--o300)}
.perk b{font-size:19px}
.values{font-weight:700;margin-bottom:26px!important;color:var(--navy)!important}

/* pages internes */
.page-top{padding:60px 0 20px}
.page-top h1{font-size:clamp(30px,4vw,40px)}
.filters{background:#fff;border-radius:12px;box-shadow:var(--sh);padding:22px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px 12px;margin:24px 0}
.f label,.field label{display:block;font-size:12px;font-weight:800;margin-bottom:6px}
.f input,.f select,.field input,.field select,.field textarea{width:100%;font:500 15px 'DM Sans',sans-serif;padding:12px 14px;border:1px solid #DCE3E7;border-radius:8px;background:#fff;color:var(--navy)}
.field textarea{min-height:120px;resize:vertical}
.f input:focus,.f select:focus,.field input:focus,.field select:focus,.field textarea:focus{outline:2px solid var(--orange);border-color:transparent}
.filters .row{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.reset{font-weight:700;text-decoration:underline;cursor:pointer;background:none;border:0;font-size:14px;color:var(--navy)}
.results{padding-bottom:80px}
.empty{background:#fff;border-radius:12px;text-align:center;padding:60px 20px}
.empty h3{font-size:24px;margin-bottom:18px}
.count{color:var(--muted);margin-bottom:18px}
.pale-page{background:var(--pale);min-height:60vh}

/* détail */
.back{display:inline-block;margin:36px 0 18px;font-weight:700;font-size:14px}
.detail{display:grid;grid-template-columns:1fr 340px;gap:40px;align-items:start;padding-bottom:80px}
.gal-main{position:relative;height:440px;border-radius:12px;overflow:hidden;background:#DDE4E8}
.gal-main img{width:100%;height:100%;object-fit:cover}
.thumbs{display:flex;gap:12px;margin-top:12px}
.thumbs button{border:3px solid transparent;border-radius:8px;overflow:hidden;width:86px;height:68px;padding:0;cursor:pointer;background:#DDE4E8}
.thumbs button.on{border-color:var(--orange)}
.thumbs img{width:100%;height:100%;object-fit:cover}
.detail h1{font-size:clamp(28px,4vw,40px);margin:26px 0 6px}
.detail h2{font-size:20px;margin:34px 0 10px}
.detail p,.detail li{color:var(--muted);font-size:16px}
.detail ul{padding-left:20px}
.side{position:sticky;top:98px;background:#fff;border-radius:var(--r);box-shadow:var(--sh);padding:24px;display:grid;gap:12px}
.side .price{font-size:28px;font-weight:800}
.alert{background:#FFF4EC;border:1px solid var(--o300);border-radius:10px;padding:12px 16px;margin:0 0 18px;font-size:14px}

/* formulaires */
.form-card{background:#fff;border-radius:12px;box-shadow:var(--sh);padding:36px;max-width:952px;margin:24px auto 80px}
.field{margin-bottom:18px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}
.steps-bar{display:flex;justify-content:space-between;margin-bottom:12px}
.dot{width:33px;height:33px;border-radius:50%;background:#E7ECEF;font-weight:800;font-size:12px;display:grid;place-items:center}
.dot.on{background:var(--orange);color:#fff}
.bar{height:6px;background:#F1F5F9;border-radius:3px;margin-bottom:30px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--orange);transition:.3s}
.form-card h2{font-size:24px;margin-bottom:20px}
.actions{display:flex;justify-content:space-between;gap:12px;margin-top:26px}
.step-box{display:none}.step-box.on{display:block}
.drop{border:2px dashed #CBD5E1;border-radius:12px;background:var(--pale);text-align:center;padding:40px 20px}
.previews{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.previews img{width:110px;height:84px;object-fit:cover;border-radius:8px}
.recap{list-style:none;display:grid;gap:8px}
.recap li{background:var(--pale);border-radius:8px;padding:10px 14px;font-size:15px}
.recap b{color:var(--orange);margin-right:6px}
.narrow{max-width:560px;margin:70px auto 100px;text-align:center}
.narrow p{color:var(--muted);margin:16px 0 28px}

/* footer */
.ft{background:var(--navy);color:#CBD5E1;padding:56px 0 0}
.ft-g{display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr;gap:40px}
.ft img{height:44px;width:auto;margin-bottom:14px}
.ft h4{color:#fff;font-size:16px;margin-bottom:14px}
.ft a{display:block;font-size:14px;margin-bottom:9px}.ft a:hover{color:#fff}
.ft p{font-size:14px}
.ft-b{border-top:1px solid rgba(255,255,255,.2);margin-top:40px;padding:20px 0;font-size:14px}

@media(max-width:980px){
  .grid{grid-template-columns:repeat(2,1fr)}
  .tiles.t4{grid-template-columns:repeat(2,1fr)}
  .steps{grid-template-columns:repeat(2,1fr)}
  .split,.detail{grid-template-columns:1fr}
  .side{position:static}
  .filters{grid-template-columns:1fr 1fr}
  .ft-g{grid-template-columns:1fr 1fr}
}
@media(max-width:760px){
  .hd-in{height:64px}.logo img{height:36px}
  .burger{display:block}
  .menu{display:none;position:absolute;left:0;right:0;top:64px;background:#fff;flex-direction:column;align-items:flex-start;padding:16px 20px 24px;gap:18px;box-shadow:0 12px 24px rgba(16,44,68,.12)}
  .menu.open{display:flex}
  .nav,.hd-r{flex-direction:column;align-items:flex-start;gap:14px}
  .hero{padding:90px 0 70px}
  .searchbar{grid-template-columns:1fr;padding:14px}
  .sfield{border-right:0;border-bottom:1px solid var(--line);padding:10px 8px}
  .searchbar .btn{height:52px;margin-top:12px}
  .section{padding:56px 0}
  .grid,.steps,.perks,.two,.filters{grid-template-columns:1fr}
  .gal-main{height:280px}
  .split img{height:280px}
  .form-card{padding:22px}
}

/* DEKOUWAYE – logique du site (menu, recherche, détail, favoris, publication) */
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const fcfa = n => Number(n).toLocaleString('fr-FR').replace(/[  ]/g, ' ') + ' FCFA';
const norm = s => (s || '').toString().normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const PH = 'assets/placeholder.svg';
const imgTag = (src, alt) => `<img src="${esc(src || PH)}" alt="${esc(alt || '')}" loading="lazy" onerror="this.onerror=null;this.src='${PH}'">`;

function store(k, def) { try { const v = JSON.parse(localStorage.getItem(k)); return v === null ? def : v; } catch (e) { return def; } }
function save(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); return true; } catch (e) { return false; } }
const allLogements = () => LOGEMENTS.concat(store('dek_annonces', []));
const getFavs = () => store('dek_favs', []);
const params = () => new URLSearchParams(location.search);

/* ---------- en-tête / pied de page ---------- */
function layout() {
  const page = document.body.dataset.page;
  const on = p => (page === p ? 'on' : '');
  $('#site-header').outerHTML = `
  <header class="hd"><div class="wrap hd-in">
    <a href="index.html" class="logo"><img src="assets/logo.png" alt="DEKOUWAYE"></a>
    <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false">☰</button>
    <div class="menu" id="menu">
      <nav class="nav">
        <a href="index.html" class="${on('home')}">Accueil</a>
        <a href="recherche.html" class="${on('search')}">Trouver un logement</a>
        <a href="publier.html" class="${on('publish')}">Publier une annonce</a>
        <a href="a-propos.html" class="${on('about')}">À propos</a>
      </nav>
      <div class="hd-r">
        <a href="favoris.html">♡ Favoris <span id="favcount">0</span></a>
        <a href="connexion.html">Se connecter</a>
        <a class="btn btn-o" href="publier.html">Publier une annonce</a>
      </div>
    </div>
  </div></header>`;
  $('#site-footer').outerHTML = `
  <footer class="ft"><div class="wrap">
    <div class="ft-g">
      <div><img src="assets/logo-blanc.png" alt="DEKOUWAYE"><p>Trouvez. Visitez. Décidez. Emménagez.</p></div>
      <div><h4>Explorer</h4><a href="index.html">Accueil</a><a href="recherche.html">Trouver un logement</a><a href="publier.html">Publier une annonce</a><a href="favoris.html">Favoris</a></div>
      <div><h4>DEKOUWAYE</h4><a href="a-propos.html">À propos</a><a href="contact.html">Contact</a></div>
      <div><h4>Suivez-nous</h4><p>Les liens vers les réseaux sociaux seront ajoutés lorsque les comptes officiels seront disponibles.</p></div>
    </div>
    <div class="ft-b">© ${new Date().getFullYear()} DEKOUWAYE. Tous droits réservés.</div>
  </div></footer>`;
  const b = $('.burger'), m = $('#menu');
  b.addEventListener('click', () => { const o = m.classList.toggle('open'); b.setAttribute('aria-expanded', o); });
  updateFavCount();
}
function updateFavCount() { const c = $('#favcount'); if (c) c.textContent = getFavs().length; }

/* ---------- cartes ---------- */
function loc(l) { return l.quartier + ', ' + l.ville; }
function feat(l) { return l.chambres + ' chambre' + (l.chambres > 1 ? 's' : '') + (l.surface ? ' · ' + l.surface + ' m²' : ''); }
function card(l) {
  const fav = getFavs().includes(l.id);
  return `<article class="card">
    <a class="card-img" href="logement.html?id=${l.id}">${imgTag(l.photos && l.photos[0], l.titre)}<span class="badge">${l.dispo ? 'Disponible' : 'À louer · disponibilité à vérifier'}</span></a>
    <button class="heart ${fav ? 'on' : ''}" data-fav="${l.id}" aria-label="Ajouter aux favoris" title="Favoris">♥</button>
    <div class="card-b"><span class="eyebrow">${esc(l.type)}</span>
      <h3><a href="logement.html?id=${l.id}">${esc(l.titre)}</a></h3>
      <p>${esc(loc(l))}</p><p>${feat(l)}</p>
      <div class="card-f"><b>${fcfa(l.prix)} / mois</b><a href="logement.html?id=${l.id}">Voir le logement →</a></div>
    </div></article>`;
}
document.addEventListener('click', e => {
  const h = e.target.closest('[data-fav]'); if (!h) return;
  e.preventDefault();
  const id = Number(h.dataset.fav); let f = getFavs();
  f = f.includes(id) ? f.filter(x => x !== id) : f.concat(id);
  save('dek_favs', f); updateFavCount();
  const p = document.body.dataset.page;
  if (p === 'favs') renderFavs(); else $$(`[data-fav="${id}"]`).forEach(b => b.classList.toggle('on', f.includes(id)));
});

/* ---------- accueil ---------- */
function initHome() {
  $('#home-listings').innerHTML = allLogements().slice(0, 6).map(card).join('');
  $('#cats').innerHTML = CATEGORIES.map(c => `<a class="tile big" href="recherche.html?type=${encodeURIComponent(c[0])}">${imgTag(c[2], c[1])}<span>${c[1]}</span></a>`).join('');
  $('#quartiers').innerHTML = QUARTIERS.map(q => `<a class="tile sm" href="recherche.html?lieu=${encodeURIComponent(q[0])}">${imgTag(q[1], q[0])}<span>${q[0]}</span></a>`).join('');
}

/* ---------- recherche ---------- */
function initSearch() {
  const p = params(), f = $('#filters');
  ['lieu', 'type', 'min', 'max', 'tri'].forEach(k => { if (f[k] && p.get(k)) f[k].value = p.get(k); });
  if (p.get('budget') && !p.get('max')) f.max.value = p.get('budget');
  const lieu = norm(f.lieu.value), type = f.type.value;
  const min = Number(f.min.value) || 0, max = Number(f.max.value) || Infinity;
  let r = allLogements().filter(l =>
    (!lieu || norm(l.quartier + ' ' + l.ville + ' ' + l.titre).includes(lieu)) &&
    (!type || l.type === type) && l.prix >= min && l.prix <= max);
  if (f.tri.value === 'asc') r.sort((a, b) => a.prix - b.prix);
  if (f.tri.value === 'desc') r.sort((a, b) => b.prix - a.prix);
  $('#count').textContent = r.length + ' résultat' + (r.length > 1 ? 's' : '') + ' · annonces de démonstration';
  $('#results').innerHTML = r.length ? r.map(card).join('') :
    `<div class="empty" style="grid-column:1/-1"><h3>Aucun logement ne correspond à votre recherche.</h3><a class="btn btn-o" href="recherche.html">Réinitialiser les filtres</a></div>`;
  $('#reset').addEventListener('click', () => { location.href = 'recherche.html'; });
}

/* ---------- détail ---------- */
function initDetail() {
  const id = Number(params().get('id')), l = allLogements().find(x => x.id === id), box = $('#detail');
  if (!l) { box.innerHTML = `<div class="empty"><h3>Ce logement est introuvable.</h3><a class="btn btn-o" href="recherche.html">Voir tous les logements</a></div>`; return; }
  document.title = l.titre + ' – DEKOUWAYE';
  const ph = l.photos && l.photos.length ? l.photos : [PH];
  const fav = getFavs().includes(l.id);
  const banner = params().get('nouveau') ? `<div class="alert"><b>Votre annonce a été enregistrée sur cet appareil.</b> Il s’agit d’une démonstration : elle n’est pas visible par les autres visiteurs.</div>` : '';
  box.innerHTML = `${banner}<div class="detail"><div>
    <div class="gal-main" id="gmain">${imgTag(ph[0], l.titre)}<button class="heart ${fav ? 'on' : ''}" data-fav="${l.id}" aria-label="Favoris">♥</button></div>
    <div class="thumbs">${ph.map((s, i) => `<button class="${i ? '' : 'on'}" data-i="${i}" aria-label="Photo ${i + 1}">${imgTag(s, '')}</button>`).join('')}</div>
    <span class="eyebrow" style="margin-top:28px">${esc(l.type)}</span>
    <h1>${esc(l.titre)}</h1><p>${esc(loc(l))}</p>
    <h2>Description</h2><p>${esc(l.desc)}</p>
    <h2>Caractéristiques</h2><p>${feat(l)} · ${l.meuble ? 'Meublé' : 'Non meublé'} · ${l.dispo ? 'Disponible' : 'Disponibilité à vérifier'}</p>
    <h2>Équipements</h2>${l.equip && l.equip.length ? `<ul>${l.equip.map(e => `<li>${esc(e)}</li>`).join('')}</ul>` : '<p>Non précisés.</p>'}
    <h2>Informations importantes</h2><p>Annonce de démonstration. Vérifiez les informations et la disponibilité avant toute démarche.</p>
    <h2>Localisation</h2><p>${esc(loc(l))} · emplacement précis non communiqué.</p>
  </div>
  <aside class="side"><div class="price">${fcfa(l.prix)}</div><div class="muted" style="margin-top:-8px">par mois · annonce de démonstration</div>
    <a class="btn btn-o btn-block" href="contact.html?logement=${l.id}">Contacter le propriétaire</a>
    <a class="btn btn-l btn-block" href="contact.html?logement=${l.id}&visite=1">Organiser une visite</a>
    <button class="btn btn-l btn-block" data-fav="${l.id}" id="favbtn">${fav ? '♥ Dans mes favoris' : '♡ Ajouter aux favoris'}</button>
  </aside></div>`;
  $$('.thumbs button').forEach(b => b.addEventListener('click', () => {
    $('#gmain img').src = ph[b.dataset.i]; $$('.thumbs button').forEach(x => x.classList.toggle('on', x === b));
  }));
  $('#favbtn').addEventListener('click', () => { setTimeout(() => { $('#favbtn').textContent = getFavs().includes(l.id) ? '♥ Dans mes favoris' : '♡ Ajouter aux favoris'; }); });
}

